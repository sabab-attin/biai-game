# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret

# MongoDB is the source of truth for every record
MONGODB_URI=mongodb://127.0.0.1:27017/carnival_wheel
MAX_SPINS_PER_PLAYER=1

# Generated CSV + durable backups (relative to backend/)
CSV_FILE_PATH=./data/records.csv
BACKUP_DIR=./backups
RECORD_LOG_PATH=./backups/records.log.jsonl
CSV_SNAPSHOT_DIR=./backups/csv-snapshots

# Admin accounts (created automatically on startup, or run `npm run seed:admin`)
# Comma-separated usernames. All accounts share ADMIN_PASSWORD.
ADMIN_USERNAMES=Nusrat,Zunaid
ADMIN_PASSWORD=replace-with-a-strong-password
# Alternatively provide a bcrypt hash and omit ADMIN_PASSWORD:
# ADMIN_PASSWORD_HASH=$2b$10$...

# Admin sessions + login throttling
COOKIE_SECURE=false
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MS=900000
